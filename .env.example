# Copy to .env for local work: deno run --env-file=.env -A server.ts
# Full descriptions in docs/DEPLOY.md.

# Port the relay listens on.
PORT=8787

# Signs /demo room ids. Set a long random value in production (openssl rand -hex 32),
# or every demo QR code stops working when the process restarts.
STAGETYPE_SECRET=

# Turns on the Deepgram engine. Leave empty for browser speech only.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
