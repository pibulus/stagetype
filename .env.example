# Copy to .env for local work: deno run --env-file=.env -A server.ts
# Full descriptions in docs/DEPLOY.md.

# Port and bind address the relay listens on. Use HOST=127.0.0.1 behind cloudflared/nginx.
PORT=8787
HOST=0.0.0.0

# Proxy client-IP trust mode: "cloudflare" (reads CF-Connecting-IP from loopback only), "fly", or blank.
TRUST_PROXY=

# Global RAM cap (MB) for live shared images across all open rooms (default 128).
MAX_ASSET_RAM_MB=128

# Signs /demo room ids. Set a long random value in production (openssl rand -hex 32),
# or every demo QR code stops working when the process restarts.
STAGETYPE_SECRET=

# Turns on Cloud Turbo (Groq whisper-large-v3-turbo, ~US$0.04/hr) and/or Deepgram Live.
GROQ_API_KEY=
# GROQ_MODEL=whisper-large-v3-turbo
# GROQ_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
DEEPGRAM_API_KEY=
# Pass code gating public Cloud Turbo & Deepgram audio sessions (STRONGLY RECOMMENDED on a public host).
STAGETYPE_DEEPGRAM_PASS=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
# DEEPGRAM_BATCH_URL=https://api.deepgram.com/v1/listen

# Optional Square Event Passes (Meetup 3h A$5 / Day 24h A$12 / Weekend 72h A$24; $1/pass to Palestine).
# Leave unset for free browser speech or private STAGETYPE_DEEPGRAM_PASS relays.
STAGETYPE_PASS_SECRET=
STAGETYPE_DATA_DIR=
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-01-22
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
PUBLIC_APP_URL=

# Optional commit SHA served at /version.json for deploy verification.
STAGETYPE_VERSION=
